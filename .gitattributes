# Small project assets are stored directly in Git; no LFS installation required.
* text=auto
*.cs text eol=lf diff=csharp
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset -text
*.png binary
*.jpg binary
*.fbx binary
*.FBX binary
